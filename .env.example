# Polymarket CLOB API
# Get these from https://polymarket.com (API section)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_HOST=https://clob.polymarket.com

# Telegram Bot
# 1. Create a bot via @BotFather on Telegram
# 2. Get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot defaults
RISK_PER_TRADE_USD=10
CONFIDENCE_THRESHOLD=0.55
DEFAULT_STRATEGY=both

# Database (SQLite — no changes needed for local)
DATABASE_URL=sqlite:///./polytrip.db
